# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results
/playwright-report
/tests/screenshots
/tests/.auth
/.playwright-mcp
/.playwright-cli
/logged-in

# AI editor/agent config (local tooling, not project code)
.claude/
.cursor/
.antigravitycli/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/certificates

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# supabase
.supabase

# test screenshots and images (keep test-images folder but ignore root level screenshots)
/*.png
/*.jpg
/*.jpeg
/*.webm
/demo-*.jpg
/test-images/
/test-screenshots/
/test-results/

# logs
/logs/

# Keep project documentation (living + archived)
!README.md
!Documentation/**/*.md

# docs/ is auto-generated by harness skills (requirements/traceability/test-cases).
# Regenerable on demand — do not track. Re-generate with the generate-* skills when needed.
/docs/
